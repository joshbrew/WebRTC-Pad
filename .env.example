# Copy to .env on the gaming computer. This file contains no account secrets.
# No account required: blank ICE settings use the built-in public STUN catalog.
# Providers and a health-check command: system/docs/public-stun.md.
# Optional Metered account (only used when an API key is supplied):
METERED_DOMAIN=
METERED_API_KEY=
# Optional fallback if the credential API cannot be reached:
METERED_USERNAME=
METERED_CREDENTIAL=
METERED_RELAY=global.relay.metered.ca
# 'all' tries a direct connection first; 'relay' is useful for testing TURN.
ICE_TRANSPORT_POLICY=all
HOST=127.0.0.1
PORT=8787
# Initial batch for console/manual hosting: 1..64 (XInput-only: 1..4).
# Browser press-to-join grows adaptively and creates no idle pads.
PLAYER_COUNT=4
# Windows output defaults to auto: available XInput slots first, then HID.
# Optional compatibility override: x360 only or ds4 only.
# Guests can use any supported brand. Auto/HID/native press-to-join has no fixed app cap.
WINDOWS_CONTROLLER_TYPE=auto
# 0 = no configured participant cap; bandwidth and game limits still apply.
MAX_PEERS=0
# Optional authenticated WSS fallback. See system/docs/port-forwarding.md.
PUBLIC_URL=
SIGNALING_FALLBACK=0
# Optional hosted invite UI. Blank means local invite/reply files only.
# Point local host/guest apps at a separately running HTTPS invite server:
SESSION_SERVER_URL=
# Advanced: enable the invite endpoint in the regular app (off by default).
SESSION_SERVER_ENABLED=0
# Standalone 10-Run-Invite-Server enables these modes internally, on port 8790.
SESSION_SERVER_ONLY=0
SESSION_SERVER_HOST=127.0.0.1
SESSION_SERVER_PORT=8790
SESSION_SERVER_MAX_CLIENTS=512
# Optional self-hosted coturn; explicit TURN_URL takes priority over Metered.
# STUN_URL overrides the public defaults; separate multiple URLs with commas.
# STUN finds direct routes. Restrictive networks may still require TURN below.
STUN_URL=
TURN_URL=
TURN_USER=
TURN_CRED=
TURN_AUTH_SECRET=
TURN_TTL_SECONDS=86400
# Optional native capture (npm run setup:native). No capture occurs at startup.
FFMPEG_BIN=
NATIVE_MEDIA_HELPER=
# Optional Windows WASAPI helper path; native setup builds the default locally.
NATIVE_AUDIO_HELPER=
# Leave blank to try available hardware encoders. libx264 opts into CPU encoding.
NATIVE_ENCODER=
# Advanced encoder tuning; defaults favor immediate output.
# NVIDIA p1..p7: higher presets trade more encoding time for compression quality.
NATIVE_NVENC_PRESET=p1
# Intel in-flight frames, 1..8. Higher values add delay; keep 1 for remote play.
NATIVE_QSV_ASYNC_DEPTH=1
NATIVE_DISPLAY_INDEX=0
# Windows: auto tries DXGI then Windows Graphics Capture. Or force dda / wgc.
NATIVE_WINDOWS_CAPTURE=auto
# Advanced Windows window capture: current decimal HWND; blank shares a monitor.
# Window handles change when applications reopen. Check the host preview.
NATIVE_WINDOW_HANDLE=
NATIVE_MAX_PROFILES=4
# Prefer immediate native video presentation; use 0 for ordinary browser smoothing.
NATIVE_PLAYOUT_DELAY=1
# macOS 13+: run mac/07-Host-Native.command; choose windows/screens in the app.
# Optional custom Swift helper path (normally auto-detected):
NATIVE_MAC_HELPER=
# Linux X11 source dimensions; leave blank to detect using xrandr.
NATIVE_SCREEN_SIZE=
