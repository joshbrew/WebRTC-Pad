# Copy to .local/coturn/turnserver.conf and replace the hostname/IP/secret.
# Or generate a private configuration: npm run setup:turn -- --hostname turn.example.com --public-ip YOUR_PUBLIC_IP
listening-port=3478
listening-ip=0.0.0.0
# Public IPv4 address. Behind NAT, forward the same relay port numbers.
external-ip=203.0.113.10
min-port=49160
max-port=49359
realm=turn.example.com
fingerprint
use-auth-secret
static-auth-secret=REPLACE_WITH_A_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
stale-nonce=600
no-tls
no-dtls
no-tcp-relay
no-multicast-peers
no-cli
user-quota=200
total-quota=500
log-file=stdout
simple-log
pidfile=/tmp/turnserver.pid
